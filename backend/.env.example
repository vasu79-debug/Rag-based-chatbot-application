# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5177,http://127.0.0.1:5173

# AI Provider Settings (groq, openai, openrouter, ollama)
AI_PROVIDER=groq
AI_DEFAULT_MODEL=openai/gpt-oss-20b
AI_TEMPERATURE=0.2

# Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vector Store & Embedding Settings
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2

# RAG Hyperparameters
RAG_TOP_K_VECTOR=20
RAG_TOP_K_BM25=20
RAG_TOP_N_RERANK=5
RAG_SIMILARITY_THRESHOLD=0.3
