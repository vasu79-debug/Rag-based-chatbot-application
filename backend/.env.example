# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5177,http://127.0.0.1:5173

# AI Provider Settings (groq, openai, openrouter, ollama, custom_openai)
AI_PROVIDER=groq
AI_DEFAULT_MODEL=openai/gpt-oss-20b
AI_TEMPERATURE=0.2

# Provider API Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Custom OpenAI-Compatible Endpoint
# Works with any server that exposes an OpenAI-compatible /v1/chat/completions API:
#   - Kaggle/Colab notebook running Ollama + Cloudflare tunnel
#   - LM Studio, vLLM, llama.cpp --server, Tabby ML, etc.
# To activate: set AI_PROVIDER=custom_openai and update the URL each Kaggle session.
CUSTOM_OPENAI_BASE_URL=https://<your-cloudflare-tunnel-id>.trycloudflare.com/v1
CUSTOM_OPENAI_API_KEY=dummy

# Vector Store & Embedding Settings
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2

# RAG Hyperparameters
RAG_TOP_K_VECTOR=20
RAG_TOP_K_BM25=20
RAG_TOP_N_RERANK=5
RAG_SIMILARITY_THRESHOLD=0.3
MAX_HISTORY_TURNS=10

# Assistant Persona, Tone & Custom Behavior
ASSISTANT_NAME="Krify AI Assistant"
COMPANY_NAME="Krify Software Technologies"
ASSISTANT_ROLE_DESCRIPTION="an enterprise AI assistant dedicated to helping with company services, software solutions, documents, and workplace operations"
ASSISTANT_TONE="professional, executive, clear, and helpful"
CUSTOM_SYSTEM_INSTRUCTIONS="Provide clean, well-structured answers using bullet points and formatting where helpful."
OUT_OF_SCOPE_MESSAGE="I am an enterprise AI assistant dedicated to helping with company knowledge, documents, services, and workplace operations. I cannot answer unrelated outside topics like entertainment, sports, or general trivia."

